<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadExternalRepulseInteraction } from "@tsparticles/interaction-external-repulse";
  import { loadExternalPushInteraction } from "@tsparticles/interaction-external-push";
  import { loadHexColorPlugin } from "@tsparticles/plugin-hex-color";
  import { loadInteractivityPlugin } from "@tsparticles/plugin-interactivity";
  import { loadMovePlugin } from "@tsparticles/plugin-move";
  import { loadCircleShape } from "@tsparticles/shape-circle";
  import { loadOutModesUpdater } from "@tsparticles/updater-out-modes";
  import { loadPaintUpdater } from "@tsparticles/updater-paint";
  import { loadSizeUpdater } from "@tsparticles/updater-size";

  document.addEventListener("DOMContentLoaded", async () => {
    await loadInteractivityPlugin(tsParticles);
    await Promise.all([
      loadHexColorPlugin(tsParticles),
      loadMovePlugin(tsParticles),
      loadCircleShape(tsParticles),
      loadPaintUpdater(tsParticles),
      loadSizeUpdater(tsParticles),
      loadOutModesUpdater(tsParticles),
      loadExternalRepulseInteraction(tsParticles),
      loadExternalPushInteraction(tsParticles),
    ]);

    await tsParticles.load({
      id: "tsparticles",
      options: {
        particles: {
          number: {
            value: 6,
            density: {
              enable: true,
              height: 600,
              width: 1200,
            },
          },
          paint: {
            fill: {
              enable: true,
              opacity: 0.5,
              color: {
                value: "#0873e8",
              },
            },
          },
          size: {
            value: 3,
            animation: {
              enable: false,
              sync: false,
            },
          },
          move: {
            enable: true,
            speed: 3,
            direction: "none",
            random: false,
            straight: false,
            outModes: "out",
          },
        },
        interactivity: {
          detectsOn: "canvas",
          events: {
            onHover: {
              enable: true,
              mode: "repulse",
            },
            onClick: {
              enable: true,
              mode: "push",
            },
          },
        },
        detectRetina: true,
      },
    });
  });
</script>

<div id="tsparticles"></div>

<style>
  #tsparticles {
    height: 100vh;
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
  }
</style>
