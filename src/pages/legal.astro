---
import {
  LEGAL_CITY,
  LEGAL_EMAIL,
  LEGAL_NAME,
  LEGAL_POSTAL_CODE,
  LEGAL_STREET,
} from "astro:env/server";
import LegalPage from "../layouts/LegalPage.astro";
import "../styles/page.css";
---

<LegalPage
  title="Impressum / Legal Notice - Filipe Santos Correa"
  description="Impressum (Anbieterkennzeichnung) gemäß § 5 DDG und § 18 Abs. 1 MStV."
>
  <article class="legal" id="de" lang="de">
    <h1>Impressum</h1>
    <p class="meta">Angaben gemäß § 5 DDG und § 18 Abs. 1 MStV</p>

    <h2>Anbieter</h2>
    <address>
      {LEGAL_NAME}
      <br />
      {LEGAL_STREET}
      <br />
      {`${LEGAL_POSTAL_CODE} ${LEGAL_CITY}`}
      <br />
      Deutschland
    </address>

    <h2>Kontakt</h2>
    <p>
      E-Mail: <a href={`mailto:${LEGAL_EMAIL}`}>{LEGAL_EMAIL}</a>
    </p>

    <h2>Datenschutz</h2>
    <p>
      Informationen zur Verarbeitung personenbezogener Daten finden Sie in der{" "}
      <a href="/privacy/">Datenschutzerklärung</a>.
    </p>
  </article>

  <article class="legal" id="en" lang="en">
    <h1>Legal Notice</h1>
    <p class="meta">
      Information pursuant to § 5 DDG (German Digital Services Act) and § 18(1)
      MStV (German Interstate Media Treaty)
    </p>

    <h2>Provider</h2>
    <address>
      {LEGAL_NAME}
      <br />
      {LEGAL_STREET}
      <br />
      {`${LEGAL_POSTAL_CODE} ${LEGAL_CITY}`}
      <br />
      Germany
    </address>

    <h2>Contact</h2>
    <p>
      Email: <a href={`mailto:${LEGAL_EMAIL}`}>{LEGAL_EMAIL}</a>
    </p>

    <h2>Privacy</h2>
    <p>
      Information on how personal data is processed can be found in the{" "}
      <a href="/privacy/#en">privacy policy</a>.
    </p>
  </article>
</LegalPage>
